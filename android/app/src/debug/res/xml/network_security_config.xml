<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security configuration.
  Allows plain HTTP only for local development hosts. This file is not
  included in release builds.
-->
<network-security-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator to host machine loopback alias -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- Local loopback -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>

        <!--
          Physical device on the same Wi-Fi as the dev backend.
          Update this to your machine's LAN IP (and AppConfig._lanDevIp)
          whenever it changes.
        -->
        <domain includeSubdomains="false">192.168.1.36</domain>
    </domain-config>

    <!-- Everything else must use HTTPS. -->
    <base-config cleartextTrafficPermitted="false" />

</network-security-config>